# Public frontend variables. Values prefixed with VITE_ are bundled into the browser.
# For branded Google OAuth consent, prefer a Supabase custom Auth/API domain
# such as https://auth.papirando.app instead of the default project-ref.supabase.co.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PUBLIC_APP_ORIGIN=
VITE_LAUNCH_MVP=true
ALLOWED_ORIGINS=https://papirando.vercel.app

# Emails adicionais com acesso admin (separados por vírgula). O domínio @papirando.com e roles admin/master já concedem acesso.
VITE_ADMIN_EMAILS=

# Optional public app origin for invite links. If omitted, the browser origin is used.

# Optional AI gateway override. In Vercel production, leave empty to use same-origin /api/ai.
VITE_AI_ENABLED=true
VITE_AI_SERVER_URL=

# Server-only variables for Vercel API routes. Never prefix provider keys with VITE_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
AI_REQUIRE_AUTH=true
AI_RATE_LIMIT_ENABLED=true
AI_RATE_LIMIT_MAX=30
AI_TRANSCRIBE_RATE_LIMIT_MAX=8
AI_RATE_LIMIT_WINDOW_MS=600000

AI_PROVIDER=openrouter
AI_FALLBACK_PROVIDER=groq
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.0-flash-001

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Meta / Instagram Graph API server-only configuration.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v23.0
META_REDIRECT_URI=https://papirando.vercel.app/api/instagram/auth
CRON_SECRET=

# Supabase Edge Function secrets. Configure with `supabase secrets set`, not in frontend env.
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=https://papirando.vercel.app
SITE_URL=https://papirando.vercel.app
SIGNUP_EMAIL_REDIRECT_TO=https://papirando.vercel.app/
SIGNUP_IP_PEPPER=
SIGNUP_EMAIL_LOG_PEPPER=

# Stripe server-only configuration.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TATICO_MONTHLY=
STRIPE_PRICE_TATICO_ANNUAL=
STRIPE_PRICE_ELITE_MONTHLY=
STRIPE_PRICE_ELITE_ANNUAL=
